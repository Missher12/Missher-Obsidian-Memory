{
  "name": "missher-obsidian-memory",
  "version": "0.1.0",
  "private": true,
  "description": "独立的 Obsidian 第二大脑与 AI 记忆插件（OBS-MEM-20261009）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:core": "node scripts/build.mjs core",
    "build:plugin": "node scripts/build.mjs plugin",
    "build:cli": "node scripts/build.mjs cli",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p packages/plugin/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "e2e:cli": "node scripts/e2e-cli.mjs",
    "e2e:mcp": "node scripts/e2e-mcp.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
